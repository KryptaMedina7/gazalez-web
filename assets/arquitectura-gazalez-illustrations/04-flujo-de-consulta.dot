digraph G { graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.35, ranksep=0.6, fontname="Arial", fontsize=18, compound=true]; node [shape=box, style="rounded,filled", fillcolor="#f2f7ef", color="#8bad94", fontcolor="#193d2e", fontname="Arial", fontsize=13, margin="0.18,0.12"]; edge [color="#63816e", fontname="Arial", fontsize=10, fontcolor="#435b4b", arrowsize=0.7];
